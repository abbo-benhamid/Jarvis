# Copie ce fichier en .env puis adapte les valeurs.

# Base PostgreSQL. Local : rôle et base créés par le README. Prod : Postgres managé UE (ex. Neon eu-central).
DATABASE_URL="postgresql://koudmen:koudmen@localhost:5432/koudmen?schema=public"

# Secret de signature des sessions (HS256). 32 caractères minimum.
# Génère-le avec : openssl rand -base64 48
SESSION_SECRET="change-moi-par-une-valeur-longue-et-aleatoire-0123456789"

# true : affiche les boutons « Essayer en tant que… » (comptes de démo seedés).
DEMO_MODE="true"

# true : affiche le bandeau « Version de test : données fictives uniquement ».
NEXT_PUBLIC_TEST_MODE="true"

# URL publique de l'application (liens d'invitation Lakou).
APP_URL="http://localhost:3000"
