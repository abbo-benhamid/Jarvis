# ───────────────────────────────────────────────────────────────────────────
# Koudmen — variables d'environnement. Copiez ce fichier en .env (local).
# Sur Vercel : Project → Settings → Environment Variables (jamais dans le dépôt).
# ───────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL ; production : Neon, région UE) ────────────
# DATABASE_URL : connexion POOLÉE pour l'application (Neon : hôte « …-pooler… »,
# ajoutez « ?sslmode=require&pgbouncer=true&connect_timeout=15 »).
DATABASE_URL="postgresql://koudmen:koudmen@localhost:5432/koudmen?schema=public"
# DIRECT_URL : connexion DIRECTE (sans pooler) pour `prisma migrate deploy`.
# En local, même valeur que DATABASE_URL.
DIRECT_URL="postgresql://koudmen:koudmen@localhost:5432/koudmen?schema=public"

# ── Sécurité ────────────────────────────────────────────────────────────────
# RÈGLE (B1, B3) : en production, l'application REFUSE DE DÉMARRER si SESSION_SECRET,
# CRON_SECRET ou un code testeur est une valeur d'exemple (comme ci-dessous), une valeur
# de CI, ou une valeur trop courte. « Production » = VERCEL_ENV=production, ou
# KOUDMEN_STRICT_CONFIG="true" (pour vérifier une configuration en local).
#
# Secret de signature des sessions (HS256). 32 caractères minimum, aléatoire.
# Générez-le avec : openssl rand -base64 48
SESSION_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres"
# Secret de la route de purge (/api/cron/purge-bacs-a-sable). Différent de SESSION_SECRET.
# Vercel Cron l'envoie dans « Authorization: Bearer … ». 32 caractères minimum en production.
# Générez-le avec : openssl rand -base64 48
CRON_SECRET="remplacez-moi-par-une-autre-valeur-aleatoire"
# Optionnel : "true" applique les contrôles de production en local (VERCEL_ENV=production le fait sur Vercel).
KOUDMEN_STRICT_CONFIG="false"
# Optionnel, LOCAL ET CI SEULEMENT : "true" désactive les limites de débit (e2e).
# Interdit en production (démarrage refusé).
RATE_LIMIT_DISABLED="false"

# ── Test utilisateurs (S1b, S1c) ────────────────────────────────────────────
# Codes d'invitation testeur, séparés par des virgules (D3). UN CODE PAR TESTEUR.
# Production : codes ALÉATOIRES de 12 caractères ou plus. Générez-les avec :
#   pnpm ops:generate-codes 20
# Les valeurs ci-dessous sont des exemples : elles sont refusées en production.
TESTER_INVITE_CODES="CODE-A-REMPLACER-1,CODE-A-REMPLACER-2"
# Date de fin du test (AAAA-MM-JJ). Affichée dans les CGU de test et la politique de
# confidentialité. Les avis et la mesure d'usage sont effacés 6 mois après cette date.
TEST_END_DATE=""
# Bandeau « Version de test » et bouton « Simuler ma position » : actifs par défaut.
# Mettez "false" seulement pour un vrai service (après le pilote).
NEXT_PUBLIC_TEST_MODE="true"

# ── Démonstration partagée (démos en direct du fondateur) ───────────────────
# "true" : boutons de démo sur /connexion + `pnpm db:seed` autorisé.
# PRODUCTION AVEC DE VRAIS TESTEURS : mettez "false" (D1). Les comptes démo sont alors refusés.
DEMO_MODE="true"
# Mot de passe des comptes démo seedés (jamais dans le code).
DEMO_PASSWORD="choisissez-un-mot-de-passe-demo"
# Opérateur local créé par le seed (vrai compte opérateur, pas un compte démo).
SEED_OPERATOR_EMAIL="operateur@koudmen.test"
SEED_OPERATOR_PASSWORD="choisissez-un-mot-de-passe-de-12-caracteres-min"

# ── URL publique ────────────────────────────────────────────────────────────
# Liens d'invitation et liens de reprise. Sur Vercel, si absent, l'URL de production
# Vercel (VERCEL_PROJECT_PRODUCTION_URL) est utilisée.
APP_URL="http://localhost:3000"

# ── Mentions légales (D4) ───────────────────────────────────────────────────
# Laissées vides, les pages affichent « [à compléter] ». À fournir par le fondateur
# AVANT d'inviter les testeurs.
EDITEUR_NOM=""
EDITEUR_ADRESSE=""
EDITEUR_EMAIL=""
DIRECTEUR_PUBLICATION=""
