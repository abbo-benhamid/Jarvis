# ───────────────────────────────────────────────────────────────────────────
# Koudmen — variables d'environnement. Copiez ce fichier en .env (local).
# Sur Vercel : Project → Settings → Environment Variables (jamais dans le dépôt).
# ───────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL ; production : Neon, région UE) ────────────
# DATABASE_URL : connexion POOLÉE pour l'application (Neon : hôte « …-pooler… »,
# ajoutez « ?sslmode=require&pgbouncer=true&connect_timeout=15 »).
DATABASE_URL="postgresql://koudmen:koudmen@localhost:5432/koudmen?schema=public"
# DIRECT_URL : connexion DIRECTE (sans pooler) pour `prisma migrate deploy`.
# En local, même valeur que DATABASE_URL.
DIRECT_URL="postgresql://koudmen:koudmen@localhost:5432/koudmen?schema=public"

# ── Sécurité ────────────────────────────────────────────────────────────────
# RÈGLE (B1, B3) : en production, l'application REFUSE DE DÉMARRER si SESSION_SECRET,
# CRON_SECRET ou un code testeur est une valeur d'exemple (comme ci-dessous), une valeur
# de CI, ou une valeur trop courte. « Production » = VERCEL_ENV=production, ou
# KOUDMEN_STRICT_CONFIG="true" (pour vérifier une configuration en local).
#
# Secret de signature des sessions (HS256). 32 caractères minimum, aléatoire.
# Générez-le avec : openssl rand -base64 48
SESSION_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-48-caracteres"
# Secret de la route de purge (/api/cron/purge-bacs-a-sable). Différent de SESSION_SECRET.
# Vercel Cron l'envoie dans « Authorization: Bearer … ». 32 caractères minimum en production.
# Générez-le avec : openssl rand -base64 48
CRON_SECRET="remplacez-moi-par-une-autre-valeur-aleatoire"
# Optionnel : "true" applique les contrôles de production en local (VERCEL_ENV=production le fait sur Vercel).
KOUDMEN_STRICT_CONFIG="false"
# Optionnel, LOCAL ET CI SEULEMENT : "true" désactive les limites de débit (e2e).
# Interdit en production (démarrage refusé).
RATE_LIMIT_DISABLED="false"

# ── Test utilisateurs (S1b, S1c) ────────────────────────────────────────────
# Codes d'invitation testeur, séparés par des virgules (D3). UN CODE PAR TESTEUR.
# Production : codes ALÉATOIRES de 12 caractères ou plus. Générez-les avec :
#   pnpm ops:generate-codes 20
# Les valeurs ci-dessous sont des exemples : elles sont refusées en production.
TESTER_INVITE_CODES="CODE-A-REMPLACER-1,CODE-A-REMPLACER-2"
# Date de fin du test (AAAA-MM-JJ). Affichée dans les CGU de test et la politique de
# confidentialité. Les avis et la mesure d'usage sont effacés 6 mois après cette date.
TEST_END_DATE=""
# Bandeau « Version de test » et bouton « Simuler ma position » : actifs par défaut.
# Mettez "false" seulement pour un vrai service (après le pilote).
NEXT_PUBLIC_TEST_MODE="true"

# ── Démonstration partagée (démos en direct du fondateur) ───────────────────
# "true" : boutons de démo sur /connexion + `pnpm db:seed` autorisé.
# PRODUCTION AVEC DE VRAIS TESTEURS : mettez "false" (D1). Les comptes démo sont alors refusés.
DEMO_MODE="true"
# Mot de passe des comptes démo seedés (jamais dans le code).
DEMO_PASSWORD="choisissez-un-mot-de-passe-demo"
# Opérateur local créé par le seed (vrai compte opérateur, pas un compte démo).
SEED_OPERATOR_EMAIL="operateur@koudmen.test"
SEED_OPERATOR_PASSWORD="choisissez-un-mot-de-passe-de-12-caracteres-min"

# ── URL publique ────────────────────────────────────────────────────────────
# Liens d'invitation et liens de reprise. Sur Vercel, si absent, l'URL de production
# Vercel (VERCEL_PROJECT_PRODUCTION_URL) est utilisée.
APP_URL="http://localhost:3000"

# ── Mentions légales (D4) ───────────────────────────────────────────────────
# Laissées vides, les pages affichent « [à compléter] ». À fournir par le fondateur
# AVANT d'inviter les testeurs.
EDITEUR_NOM=""
EDITEUR_ADRESSE=""
EDITEUR_EMAIL=""
DIRECTEUR_PUBLICATION=""

# ── Notifications push (lot N1, docs/tech/integrations/push.md) ─────────────
# "console" (défaut) : aucun envoi, une ligne « [push:console] … » dans le journal du serveur.
# "expo" : envoi réel par Expo Push API (APNs / FCM). Texte générique seulement (R9).
ADAPTER_PUSH="console"
# Optionnel : seulement si la « sécurité renforcée des push » est active sur le projet Expo.
# Ne jamais la mettre dans le dépôt.
EXPO_ACCESS_TOKEN=""
# X2 (V1c) : en production stricte, ADAPTER_PUSH="expo" est REFUSÉ tant que le DPO n'a pas validé le push
# (DPA Expo signé, transfert hors UE déclaré). Mettez "true" seulement après cette validation.
PUSH_DPO_VALIDE=""

# ── Proxy de confiance (PM1, V1c) ───────────────────────────────────────────
# Seul l'en-tête du proxy choisi est cru pour l'IP du client (limites de débit).
# "vercel" (détecté seul sur Vercel), "clevercloud" (dernière valeur de X-Forwarded-For), "aucun" (défaut hors Vercel).
TRUST_PROXY=""

# ── Présence : carte domicile, adresse, trajet (lot L1-B, docs/tech/L1-B-notes.md) ──
# Clé de signature des cartes domicile (QR signé EdDSA). 32 octets aléatoires en base64 :
#   openssl rand -base64 32
# (ou une clé Ed25519 PKCS#8 PEM). L1d (D2) : OBLIGATOIRE dès que les données réelles sont ouvertes
# (DONNEES_REELLES_AUTORISEES=true en lancement), en production ET avec NODE_ENV=production (Preview, Clever Cloud).
# Valeur d'exemple, clé de développement ou clé trop régulière : configuration refusée.
# Vide en local (ou en préinscription) : une clé de développement publique est utilisée.
# Changer cette clé rend TOUTES les cartes imprimées invalides (il faut les régénérer).
QR_SIGNING_KEY=""
# Clé de chiffrement de l'adresse des aînés (AES-256-GCM). 32 octets aléatoires en base64 :
#   openssl rand -base64 32
# Mêmes règles que QR_SIGNING_KEY (D2), différente d'elle. Chiffre l'adresse ET la position précise du domicile (D3).
# Ne la perdez pas : sans elle, les adresses sont illisibles (copie dans un coffre hors de Vercel).
ADDRESS_ENC_KEY=""
# Géocodage de l'adresse : "api-adresse" (api-adresse.data.gouv.fr, défaut) ou "simule" (tests, sans réseau).
ADAPTER_GEOCODAGE=""
# ── Mode du site et données réelles (lot L1-A, docs/tech/L1-A-notes.md) ─────
# KOUDMEN_MODE : "lancement" (site réel : pas de démo, pas de bac à sable, pas de paiement simulé)
# ou "essai" (démo, bac à sable, robots : développement et tests). Vide : "lancement" en production
# (VERCEL_ENV=production ou NODE_ENV=production, donc aussi `next start`), "essai" sinon.
# L1d (D1) : "essai" est REFUSÉ en production stricte (page 503), comme DEMO_MODE="true" et KOUDMEN_OPERATEUR_CONFIRME="true".
KOUDMEN_MODE=""
# R1 : données réelles des aînés (fiche, adresse, carte domicile, Kayé, trajet). Vide ou "false" en lancement :
# mode PRÉINSCRIPTION (comptes ouverts, demandes de rappel, aucune donnée d'aîné). "true" est REFUSÉ au démarrage
# en production sans les trois variables suivantes. Sans effet en mode essai (données d'exemple).
DONNEES_REELLES_AUTORISEES=""
# Hébergeur certifié HDS (ex. "Clever Cloud HDS"), date de validation de l'AIPD (AAAA-MM-JJ), contact du DPO.
HEBERGEUR_HDS=""
AIPD_DATE=""
DPO_CONTACT=""
# P1 : date d'ouverture visée, affichée aux familles en préinscription. "AAAA-MM" (« en mars 2027 ») ou "AAAA-MM-JJ".
# Vide, invalide ou passée : l'interface dit « bientôt ».
OUVERTURE_PREVUE=""

# ── E-mails de compte (lot L1-A) ───────────────────────────────────────────
# Clé API Brevo (transactionnel). Absente : aucun e-mail ne part (adaptateur console) ; /api/sante l'indique
# et l'opérateur valide les e-mails à la main (page « Comptes »). Ne jamais la mettre dans le dépôt.
BREVO_API_KEY=""
# Expéditeur : « Nom <adresse> » ou « adresse ». Domaine à vérifier dans Brevo (SPF, DKIM). [À VÉRIFIER] domaine.
MAIL_FROM="Koudmen <ne-pas-repondre@koudmen.fr>"
# LOCAL ET CI SEULEMENT : fichier où l'adaptateur console écrit chaque e-mail (JSON, une ligne par e-mail).
# Ignoré en production stricte. Les e2e du mode lancement lisent les liens dans ce fichier.
MAIL_CAPTURE_FILE=""

# ── Vérification de l'accompagnant (lot L2, ADR 0009, docs/tech/L2-I-notes.md) ──
# RÈGLE : tous les services sont SIMULÉS par défaut. Un service simulé est FERMÉ en mode lancement :
# l'équipe vérifie alors par appel ou en visio (repli humain). Une clé absente = avertissement dans /api/sante,
# jamais une page 503 en préinscription. Ne mettez JAMAIS une vraie clé dans ce fichier.
#
# Téléphone : "simule" (code 000000, mode essai) ou "brevo" (SMS réel, BREVO_API_KEY ci-dessus + expéditeur).
ADAPTER_OTP="simule"
# Expéditeur SMS (11 caractères au plus, ex. Koudmen). [À VÉRIFIER] acceptation par les opérateurs des Antilles.
BREVO_SMS_SENDER=""
# Appel vocal de repli : "simule" ou "twilio" (désactivé sans les 3 clés).
ADAPTER_OTP_APPEL="simule"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Numéro Twilio qui appelle (E.164, ex. +590590000000).
TWILIO_FROM_NUMBER=""
# Plafond quotidien des SMS et appels, en centimes (défaut 1000 = 10 €). Au-delà : envois suspendus, alerte opérateur.
SMS_DAILY_BUDGET_CENTS=""
# Facultatif : réduit la liste des préfixes acceptés (T1, T5). Vide (défaut) : les 4 territoires de src/lib/territoires.ts
# (Guadeloupe +590 690/691/590, Martinique +596 696/697/596, Guyane +594 694/594, Hexagone +33). Ex. "+590" : Guadeloupe seulement.
PHONE_ALLOWED_PREFIXES=""
#
# Identité : "simule" (page /verification/simulee, essai seulement), "veriff" (principal) ou "stripe" (repli).
ADAPTER_IDENTITY="simule"
# Veriff : clé publique d'intégration (X-AUTH-CLIENT) et clé partagée (signature HMAC des webhooks).
# Webhook à déclarer dans Veriff : https://<domaine>/api/webhooks/identite/veriff
VERIFF_API_KEY=""
VERIFF_SHARED_SECRET=""
# Facultatif : autre point d'accès Veriff (défaut https://stationapi.veriff.com).
VERIFF_BASE_URL=""
# Stripe Identity (repli, sur décision humaine). Webhook : https://<domaine>/api/webhooks/identite/stripe
STRIPE_SECRET_KEY=""
STRIPE_IDENTITY_WEBHOOK_SECRET=""
# Secret de la page simulée (mode essai). Vide : clé de développement publique.
SIMULATED_WEBHOOK_SECRET=""
#
# Entreprise : "simule", "recherche-entreprises" (API ouverte, sans clé) ou "insee" (API Sirene, puis repli).
ADAPTER_SIRENE="simule"
INSEE_API_KEY=""
# Document d'entreprise : "si_doute" (défaut) ou "toujours".
COMPANY_DOC_REQUIRED="si_doute"
# Justificatif d'adresse exigé (défaut true). "false" seulement après l'avis de l'avocat (étude § 4.2).
ADDRESS_PROOF_REQUIRED=""
#
# Documents : "simule" (clé de développement, essai seulement) ou "base-chiffree" (AES-256-GCM, clé ci-dessous).
ADAPTER_DOCUMENTS="simule"
# Clé maîtresse des documents : 32 octets aléatoires en base64 (openssl rand -base64 32). Différente de ADDRESS_ENC_KEY.
# Exigée seulement avec ADAPTER_DOCUMENTS=base-chiffree. Ne la perdez pas : sans elle, les fichiers sont illisibles.
DOCUMENT_ENC_KEY=""
# L2b (M6) : clé HMAC DÉDIÉE (empreintes des numéros, des pièces et des codes SMS). 32 octets aléatoires :
#   openssl rand -base64 32
# OBLIGATOIRE (page 503) dès qu'un adaptateur réel est actif (ADAPTER_OTP, ADAPTER_OTP_APPEL, ADAPTER_IDENTITY,
# ADAPTER_DOCUMENTS) ou que les données réelles sont ouvertes. Exigée aussi en lancement pour valider un numéro.
# Aucun repli sur SESSION_SECRET. Vide en développement et en tests : clé de développement publique (empreintes « h0: »).
# Différente de SESSION_SECRET, CRON_SECRET, DOCUMENT_ENC_KEY et ADDRESS_ENC_KEY. Ne la changez pas sans rotation :
VERIFICATION_HMAC_KEY=""
# Version de la clé courante (préfixe des empreintes « h<version>: »). Défaut 1.
VERIFICATION_HMAC_KEY_VERSION=""
# Rotation : l'ancienne clé et sa version, gardées pendant la migration (les doublons restent trouvés).
VERIFICATION_HMAC_KEY_PREVIOUS=""
VERIFICATION_HMAC_KEY_PREVIOUS_VERSION=""
# L2b (m2) : plafond quotidien des SMS et appels PAR COMPTE (centimes). Défaut 60.
SMS_ACCOUNT_DAILY_BUDGET_CENTS=""
