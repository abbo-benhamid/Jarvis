// Schéma Prisma COMPLET du MVP Koudmen.
// Source de vérité : docs/tech/specification-mvp.md (§ Modèle de données).
// ATTENTION : les constructeurs ne modifient pas ce fichier sans accord de l'architecte.
// Données fictives uniquement pendant les tests. Aucun champ de santé détaillé.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connexion poolée (Neon : URL « -pooler ») pour l'application.
  url       = env("DATABASE_URL")
  // Connexion directe (sans pooler) pour les migrations Prisma.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

/// Rôle d'un compte. L'aîné n'a pas de compte : c'est un profil (modèle Aine).
enum Role {
  FAMILLE
  ACCOMPAGNANT
  OPERATEUR
}

/// Lieu de vie du membre de la famille (diaspora = HEXAGONE ou AUTRE).
enum FamilyLocation {
  MARTINIQUE
  HEXAGONE
  AUTRE
}

/// Qui donne le consentement pour l'aîné.
enum ConsentBy {
  AINE
  REPRESENTANT
}

/// Besoins déclarés (catégories non médicales).
enum NeedType {
  COMPAGNIE
  APPEL_REGULIER
  COURSES
  REPAS
  DEMARCHES
  NUMERIQUE
  SORTIES
  RENDEZ_VOUS
  AIDE_LEVER
  AIDE_RENFORCEE
}

/// Formules (00 § 3, décision D5). Paiement SIMULÉ dans le MVP. « Veyé » est réservé à Veyé Siklòn.
enum Plan {
  LAKOU
  KOZE
  SERENITE
}

enum SubscriptionStatus {
  ACTIVE
  RESILIEE
}

enum PaymentStatus {
  SIMULE_REUSSI
  SIMULE_ECHEC
}

/// Statuts de l'accompagnant (08 § 2). Le statut décide des niveaux autorisés.
enum CaregiverStatus {
  SALARIE_FAMILLE_CESU
  AUTO_ENTREPRENEUR_SAP
  PROCHE_AIDANT_APA
  BENEVOLE_ASSO
  SAAD
}

/// Cycle de validation par l'opérateur (revue humaine, motif obligatoire si refus/suspension).
enum CaregiverValidation {
  BROUILLON
  EN_ATTENTE
  VALIDE
  REFUSE
  SUSPENDU
}

enum TimeSlot {
  MATIN
  APRES_MIDI
  SOIR
}

enum VerificationType {
  IDENTITE
  CASIER_B3
  REFERENCES
  FORMATION
  STATUT_PRO
  PSC1
  DIPLOME
}

enum VerificationStatus {
  A_FOURNIR
  DECLARE
  VALIDE
  REFUSE
}

enum Frequency {
  PONCTUELLE
  HEBDOMADAIRE
  DEUX_PAR_SEMAINE
  QUOTIDIENNE
}

enum RequestStatus {
  OUVERTE
  PROPOSEE
  POURVUE
  ANNULEE
}

/// Une proposition peut être refusée SANS pénalité (anti-requalification).
/// Flux D6 : Koudmen propose le profil à la famille (PROPOSEE_FAMILLE), la famille choisit
/// (EN_ATTENTE = choisi, en attente de l'accompagnant), l'accompagnant accepte ou refuse.
enum ProposalStatus {
  PROPOSEE_FAMILLE
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
  ANNULEE
}

/// Qui emploie l'accompagnant (ou reçoit la facture) : l'aîné ou son représentant (D6).
enum EmployerType {
  AINE
  REPRESENTANT
}

/// SUSPENDUE (A1) : l'accompagnant est suspendu ou refusé. Plus de check-in ni de Kayé ; visites futures annulées.
enum MissionStatus {
  ACTIVE
  TERMINEE
  ANNULEE
  SUSPENDUE
}

/// Lien d'invitation : entrer dans le cercle Lakou, ou rattacher un proche aidant à l'aîné (A6, D7).
enum InvitationKind {
  LAKOU
  PROCHE_AIDANT
}

/// VALIDEE = au moins 2 facteurs de preuve valides sur 3.
enum VisitStatus {
  PREVUE
  EN_COURS
  VALIDEE
  A_VERIFIER
  /// L1d (D4) : QR (ou code) + position, SANS la confirmation de l'aîné. La famille employeur peut contester 48 h.
  PRESENCE_PROBABLE
}

enum ProofFactor {
  GPS
  CODE_DOMICILE
  CONFIRMATION_AINE
}

enum Appetite {
  BON
  MOYEN
  FAIBLE
  NON_OBSERVE
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
  VOIX
  /// Lot N1 : notification push sur l'appareil (jeton Expo). Texte générique (R9).
  PUSH
}

/// Lot N1 : système de l'appareil qui reçoit le push.
enum PushPlatform {
  IOS
  ANDROID
}

enum OutboxStatus {
  EN_ATTENTE
  ENVOYE_SIMULE
  ECHEC
  /// Lot N1 : remis au fournisseur réel (ex. Expo Push accepte le message).
  ENVOYE
  /// V1c (m1) : push réservé, envoi en cours. Repris après 5 min (processus arrêté).
  EN_COURS
}

enum FeedbackStatus {
  NOUVEAU
  LU
  TRAITE
}

// ─────────────────────────────── Comptes ───────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role
  firstName      String
  lastName       String
  phone          String?
  /// Compte de démonstration seedé (connexion par bouton « Essayer en tant que… »).
  isDemo         Boolean   @default(false)
  /// Bac à sable du testeur (D2). Null = monde réel. Jamais visible depuis un autre bac à sable.
  sandboxId      String?
  sandbox        Sandbox?  @relation(fields: [sandboxId], references: [id])
  lastLoginAt    DateTime?
  /// Version de session (M7) : incrémentée à la déconnexion. Un jeton d'une autre version est refusé.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  familyProfile    FamilyProfile?
  caregiverProfile CaregiverProfile?

  ownedAines          Aine[]             @relation("AineOwner")
  /// L1-B (R4) : aînés dont ce compte est la « personne désignée » pour le trajet en direct.
  tripViewerOf        Aine[]             @relation("AineTripViewer")
  lakouMemberships    LakouMember[]
  invitationsSent     Invitation[]       @relation("InvitationCreator")
  invitationsAccepted Invitation[]       @relation("InvitationAcceptor")
  subscriptionsPaid   Subscription[]
  careRequests        CareRequest[]
  proposalsMade       MissionProposal[]  @relation("ProposalOperator")
  proofsRecorded      VisitProof[]
  journalEntries      JournalEntry[]
  verificationReviews VerificationItem[]
  caregiverReviews    CaregiverProfile[] @relation("CaregiverReviewer")
  notifications       OutboxMessage[]
  feedbacks           Feedback[]
  auditLogs           AuditLog[]
  proposalsChosen     MissionProposal[]  @relation("ProposalChooser")
  /// Jetons de renouvellement de l'API v1 (app mobile, ADR 0008).
  refreshTokens       RefreshToken[]
  appEvents           AppEvent[]
  kayeDrafts          KayeDraft[]
  /// Appareils qui reçoivent les notifications push (lot N1).
  pushDevices         PushDevice[]
  /// L1-B (L6) : trajet en direct en cours (accompagnant).
  visitTrips          VisitTrip[]

  // ── L1-A : comptes réels (vérification de l'e-mail, consentements) ──
  /// L3 : adresse e-mail confirmée (lien reçu, ou opérateur après un appel). Null = pas encore confirmée.
  emailVerifiedAt     DateTime?
  /// L3 : comment l'e-mail est confirmé : "LIEN" ou "OPERATEUR" (qui et quand : AuditLog).
  emailVerifiedVia    String?
  /// J25 : acceptation des CGU (case obligatoire). La politique de confidentialité est un lien, pas une case.
  cguAcceptedAt       DateTime?
  /// J25 : version des CGU acceptée (ex. "2026-10-07").
  cguVersion          String?
  /// J25 : e-mails d'information de Koudmen (case facultative, séparée).
  newsOptInAt         DateTime?
  /// L3 : jetons de vérification de l'e-mail et de mot de passe oublié (empreintes seulement).
  accountTokens       AccountToken[]
  /// L4 : demandes de rappel pour une formule payante.
  activationRequests  PlanActivationRequest[] @relation("ActivationRequester")
  activationsHandled  PlanActivationRequest[] @relation("ActivationHandler")
  /// R5 : accords d'aînés enregistrés par ce conseiller.
  ainesAccordRecorded Aine[]                  @relation("AineAccordRecorder")
  /// L1d (D11) : personnes désignées (vue du trajet) enregistrées par ce conseiller.
  tripViewersRecorded Aine[]                  @relation("AineTripViewerRecorder")

  @@index([sandboxId])
  /// L11 : purge des comptes jamais confirmés (J29) et liste opérateur « e-mails à valider ».
  @@index([emailVerifiedAt, createdAt])
}

model FamilyProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  location  FamilyLocation
  city      String?
  createdAt DateTime       @default(now())
}

// ─────────────────────────────── Aîné et cercle Lakou ───────────────────────────────

model Aine {
  id                  String     @id @default(cuid())
  firstName           String
  /// Initiale du nom seulement (minimisation).
  lastInitial         String?
  /// Code commune (voir src/lib/communes.ts), ex. "FORT_DE_FRANCE".
  commune             String
  /// Indication d'adresse libre et fictive en test (pas d'adresse exacte obligatoire).
  addressHint         String?
  /// Position approximative du domicile (centre de la commune par défaut). Sert au facteur GPS.
  latitude            Float
  longitude           Float
  /// Téléphone fixe ou mobile pour l'appel vocal simulé « tapez 1 ».
  phone               String?
  needs               NeedType[]
  /// Niveau d'activité 1 à 4 (1 Lien, 2 Coups de main, 3 Présence, 4 Aide renforcée).
  activityLevel       Int
  consentGiven        Boolean
  consentByType       ConsentBy
  /// Nom de la personne qui consent (l'aîné ou son représentant).
  consentByName       String
  consentAt           DateTime
  /// Code domicile à 6 caractères : saisie de secours sous le QR signé de la carte domicile (L9).
  homeCode            String     @unique
  /// L1-B (L8, R7) : adresse réelle du domicile, CHIFFRÉE (AES-256-GCM, clé ADDRESS_ENC_KEY, format « a1:… »).
  /// Lue par le cercle Lakou et l'opérateur ; par l'accompagnant le jour de la visite seulement (lecture journalisée).
  /// Jamais journalisée. Null = position au centre de la commune.
  addressEnc          String?
  /// L1-B (L8) : true si latitude/longitude ne sont PAS l'adresse exacte (centre de commune, géocodage peu sûr).
  locationApproximate Boolean    @default(true)
  /// L1-B (L8) : date du dernier géocodage réussi de l'adresse.
  geocodedAt          DateTime?
  /// L1-B (L9, R7) : identifiant ALÉATOIRE de la carte domicile, seul identifiant mis dans le QR signé
  /// (jamais l'id de l'aîné). Nouveau à chaque régénération. Null tant que la carte n'est pas créée.
  homeCardId          String?    @unique
  /// L1-B (L9) : version de la carte domicile (QR signé + code). +1 à chaque régénération : l'ancienne est refusée.
  homeCardVersion     Int        @default(1)
  homeCardIssuedAt    DateTime   @default(now())
  /// L1-B (R4) : « personne désignée » par l'aîné pour voir le trajet en direct (membre du cercle Lakou).
  /// Null = l'employeur (le payeur du profil). Personne d'autre ne voit le trajet.
  tripViewerId        String?
  tripViewer          User?      @relation("AineTripViewer", fields: [tripViewerId], references: [id], onDelete: SetNull)
  /// L1d (D11) : la personne désignée est CHOISIE PAR L'AÎNÉ pendant un appel du conseiller, qui l'enregistre.
  /// Date de l'appel où l'aîné l'a choisie, et conseiller qui l'a enregistrée. Null = défaut (l'employeur seul).
  tripViewerChosenAt  DateTime?
  tripViewerRecordedById String?
  tripViewerRecordedBy User?     @relation("AineTripViewerRecorder", fields: [tripViewerRecordedById], references: [id], onDelete: SetNull)
  /// L1d (D3) : position PRÉCISE du domicile (géocodage de l'adresse), CHIFFRÉE comme l'adresse (AES-256-GCM,
  /// format « g1:… »). `latitude`/`longitude` en clair = centre de la commune seulement. Null = pas de position précise.
  homeGeoEnc          String?
  /// Bac à sable du testeur (D2). Null = monde réel.
  sandboxId           String?
  sandbox             Sandbox?   @relation(fields: [sandboxId], references: [id])
  ownerId             String
  owner               User       @relation("AineOwner", fields: [ownerId], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // ── L1-A R5 (J5) : accord de l'aîné recueilli par un conseiller Koudmen, au téléphone ──
  /// État de l'accord. Demandes et visites seulement après ACCORD_RECUEILLI.
  accordEtat          AccordAine              @default(EN_ATTENTE_ACCORD)
  /// Date et heure de l'appel où l'accord (ou le refus) est donné.
  accordAt            DateTime?
  /// Conseiller qui a appelé et enregistré la réponse.
  accordRecordedById  String?
  accordRecordedBy    User?                   @relation("AineAccordRecorder", fields: [accordRecordedById], references: [id], onDelete: SetNull)
  /// Langue de l'appel : "FR" ou "GCF" (créole).
  accordLangue        String?
  /// Version de la notice FALC lue à l'aîné (ex. "FALC-2026-10").
  accordNoticeVersion String?
  /// Mesure de protection juridique de l'aîné.
  situationJuridique  SituationJuridique?
  /// Jugement ou mandat vu le … (aucune copie conservée).
  justificatifVuLe    DateTime?               @db.Date
  /// L1d (D14) : dernier appel sans réponse définitive (« rappeler plus tard »). L'état reste EN_ATTENTE_ACCORD.
  accordRappelAt      DateTime?
  /// L4 : demandes de rappel liées à cet aîné.
  activationRequests  PlanActivationRequest[]

  members      LakouMember[]
  invitations  Invitation[]
  subscription Subscription?
  requests     CareRequest[]
  missions     Mission[]
  visits       Visit[]
  journal      JournalEntry[]

  @@index([ownerId])
  @@index([sandboxId])
  /// R5 : liste opérateur « aînés à appeler ».
  @@index([accordEtat, createdAt])
}

model LakouMember {
  id       String   @id @default(cuid())
  aineId   String
  aine     Aine     @relation(fields: [aineId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lien avec l'aîné : « fille », « petit-fils », « voisine »…
  relation String
  /// Payeur = gestionnaire principal du profil.
  isPayer  Boolean  @default(false)
  joinedAt DateTime @default(now())

  @@unique([aineId, userId])
  @@index([userId])
}

model Invitation {
  id           String         @id @default(cuid())
  aineId       String
  aine         Aine           @relation(fields: [aineId], references: [id], onDelete: Cascade)
  /// Jeton aléatoire du lien d'invitation (/invitation/[token]).
  token        String         @unique
  /// LAKOU = rejoindre le cercle ; PROCHE_AIDANT = rattacher un accompagnant proche aidant à cet aîné (A6).
  kind         InvitationKind @default(LAKOU)
  email        String?
  relation     String
  createdById  String
  createdBy    User           @relation("InvitationCreator", fields: [createdById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?          @relation("InvitationAcceptor", fields: [acceptedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([aineId])
}

// ─────────────────────────────── Formules (paiement simulé) ───────────────────────────────

model Subscription {
  id         String             @id @default(cuid())
  aineId     String             @unique
  aine       Aine               @relation(fields: [aineId], references: [id], onDelete: Cascade)
  payerId    String
  payer      User               @relation(fields: [payerId], references: [id])
  plan       Plan
  /// Prix mensuel en centimes (0 pour LAKOU).
  priceCents Int
  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  endedAt    DateTime?
  payments   SimulatedPayment[]
}

model SimulatedPayment {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amountCents    Int
  status         PaymentStatus
  /// Toujours « SIMULATION » : aucun prestataire de paiement réel.
  provider       String        @default("SIMULATION")
  createdAt      DateTime      @default(now())
}

// ─────────────────────────────── Accompagnants ───────────────────────────────

model CaregiverProfile {
  id                 String              @id @default(cuid())
  userId             String              @unique
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Null tant que l'orientation en 5 questions n'est pas faite.
  status             CaregiverStatus?
  /// Réponses brutes des 5 questions (voir src/server/rules/orientation.ts).
  orientationAnswers Json?
  /// Niveaux autorisés (1 à 4), calculés par le statut. Recalculés côté serveur.
  allowedLevels      Int[]
  /// Diplôme DEAES / ADVF déclaré : ouvre le niveau 4 au salarié de la famille.
  hasDiploma         Boolean             @default(false)
  /// Codes commune desservies.
  communes           String[]
  /// Tarif horaire LIBRE fixé par l'accompagnant, en centimes. Null pour un bénévole.
  hourlyRateCents    Int?
  bio                String?
  associationName    String?
  saadName           String?
  siret              String?
  /// Proche aidant APA : l'aîné de SA famille. Il n'est proposé qu'à cet aîné (D7).
  linkedAineId       String?
  /// R6 (J26) : date de naissance, donnée à l'inscription. 18 ans minimum ; niveau 3 à partir de 21 ans.
  birthDate          DateTime?           @db.Date
  validation         CaregiverValidation @default(BROUILLON)
  /// Motif obligatoire si REFUSE ou SUSPENDU (revue humaine).
  validationReason   String?
  reviewedById       String?
  reviewedBy         User?               @relation("CaregiverReviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  availabilities CaregiverAvailability[]
  verifications  VerificationItem[]
  proposals      MissionProposal[]
  missions       Mission[]
  visits         Visit[]
}

model CaregiverAvailability {
  id          String           @id @default(cuid())
  caregiverId String
  caregiver   CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  /// 0 = lundi … 6 = dimanche.
  dayOfWeek   Int
  slot        TimeSlot

  @@unique([caregiverId, dayOfWeek, slot])
}

model VerificationItem {
  id           String             @id @default(cuid())
  caregiverId  String
  caregiver    CaregiverProfile   @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  type         VerificationType
  status       VerificationStatus @default(A_FOURNIR)
  /// Déclaration de l'accompagnant (ex. « B3 consulté le … »). Aucune pièce stockée dans le MVP.
  declaration  String?
  declaredAt   DateTime?
  reviewedById String?
  reviewedBy   User?              @relation(fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?
  /// R6 (J6) : casier B3 « vu le … » par l'opérateur. Aucun texte libre, aucune copie.
  seenOn       DateTime?          @db.Date

  @@unique([caregiverId, type])
}

// ─────────────────────────────── Demandes, propositions, missions ───────────────────────────────

model CareRequest {
  id              String        @id @default(cuid())
  aineId          String
  aine            Aine          @relation(fields: [aineId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  /// Niveau demandé 1 à 4.
  level           Int
  frequency       Frequency
  durationMinutes Int           @default(120)
  startDate       DateTime?
  notes           String?
  /// Employeur (ou client) de l'accompagnant : l'aîné ou son représentant (D6).
  employerType    EmployerType  @default(AINE)
  employerName    String?
  status          RequestStatus @default(OUVERTE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  slots     RequestSlot[]
  proposals MissionProposal[]
  mission   Mission?

  @@index([status])
}

model RequestSlot {
  id        String      @id @default(cuid())
  requestId String
  request   CareRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  slot      TimeSlot

  @@unique([requestId, dayOfWeek, slot])
}

model MissionProposal {
  id           String           @id @default(cuid())
  requestId    String
  request      CareRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  caregiverId  String
  caregiver    CaregiverProfile @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  proposedById String
  proposedBy   User             @relation("ProposalOperator", fields: [proposedById], references: [id])
  message      String?
  status       ProposalStatus   @default(EN_ATTENTE)
  /// Motif FACULTATIF. Un refus n'a jamais d'effet sur le profil.
  declineNote  String?
  /// D6 : la famille choisit ce profil (passage PROPOSEE_FAMILLE → EN_ATTENTE).
  chosenAt     DateTime?
  chosenById   String?
  chosenBy     User?            @relation("ProposalChooser", fields: [chosenById], references: [id])
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())
  mission      Mission?

  @@unique([requestId, caregiverId])
  @@index([caregiverId, status])
}

model Mission {
  id              String           @id @default(cuid())
  requestId       String           @unique
  request         CareRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  proposalId      String           @unique
  proposal        MissionProposal  @relation(fields: [proposalId], references: [id])
  aineId          String
  aine            Aine             @relation(fields: [aineId], references: [id], onDelete: Cascade)
  caregiverId     String
  caregiver       CaregiverProfile @relation(fields: [caregiverId], references: [id])
  /// Copie du tarif libre de l'accompagnant au moment de l'acceptation.
  hourlyRateCents Int?
  /// Copie de l'employeur de la demande (D6).
  employerType    EmployerType     @default(AINE)
  employerName    String?
  status          MissionStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  visits          Visit[]

  @@index([caregiverId])
  @@index([aineId])
}

// ─────────────────────────────── Visites et preuve 2 sur 3 ───────────────────────────────

model Visit {
  id             String           @id @default(cuid())
  missionId      String
  mission        Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  aineId         String
  aine           Aine             @relation(fields: [aineId], references: [id], onDelete: Cascade)
  caregiverId    String
  caregiver      CaregiverProfile @relation(fields: [caregiverId], references: [id])
  scheduledStart DateTime
  scheduledEnd   DateTime
  status         VisitStatus      @default(PREVUE)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  /// Nombre de facteurs valides (0 à 3). Recalculé par computeVisitProof().
  proofScore     Int              @default(0)
  /// Lot A2 : un événement de l'app a un écart d'horloge > 12 h. La visite reste « À vérifier »
  /// tant que l'aîné ne l'a pas confirmée (deriveVisitStatus).
  clockSkewAt    DateTime?
  /// L1-B (L10, P1/P8) : check-in reçu plus de 30 min après l'heure de l'appareil. La visite reste
  /// « À vérifier » tant que l'aîné ne l'a pas confirmée (deriveVisitStatus).
  lateCheckInAt  DateTime?
  /// L1d (D4) : la famille employeur conteste une « Présence probable » (48 h au plus après le check-in).
  /// La visite passe « À vérifier » tant que l'aîné ne l'a pas confirmée ; les opérateurs sont prévenus.
  contestedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  proofs    VisitProof[]
  journal   JournalEntry?
  kayeDraft KayeDraft?
  /// L1-B (L6) : trajet en direct en cours (au plus un, sans historique).
  trip      VisitTrip?

  @@index([aineId, scheduledStart])
  @@index([caregiverId, scheduledStart])
}

model VisitProof {
  id             String      @id @default(cuid())
  visitId        String
  visit          Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  factor         ProofFactor
  valid          Boolean
  /// true si le facteur est simulé (appel vocal simulé, position de test).
  simulated      Boolean     @default(false)
  /// GPS : UNE seule position au check-in, consentie. Jamais de suivi continu.
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Float?
  details        String?
  recordedById   String?
  recordedBy     User?       @relation(fields: [recordedById], references: [id])
  recordedAt     DateTime    @default(now())

  @@unique([visitId, factor])
}

// ─────────────────────────────── Journal Kayé ───────────────────────────────

model JournalEntry {
  id         String   @id @default(cuid())
  visitId    String   @unique
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  aineId     String
  aine       Aine     @relation(fields: [aineId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  /// Humeur 1 (très bas) à 5 (très bien).
  mood       Int
  activities String[]
  appetite   Appetite
  note       String?
  /// Signal « à surveiller » (NON médical).
  alertFlag  Boolean  @default(false)
  alertNote  String?
  createdAt  DateTime @default(now())

  @@index([aineId, createdAt])
}

// ─────────────────────────────── Transverse ───────────────────────────────

/// Notifications simulées : rien ne part réellement. L'opérateur voit la boîte d'envoi.
model OutboxMessage {
  id              String       @id @default(cuid())
  channel         Channel
  /// Destinataire affiché (téléphone ou email fictif).
  to              String
  recipientUserId String?
  recipient       User?        @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  template        String
  subject         String?
  body            String
  status          OutboxStatus @default(ENVOYE_SIMULE)
  relatedType     String?
  relatedId       String?
  /// Bac à sable d'origine (D2). Null = monde réel.
  sandboxId       String?
  sandbox         Sandbox?     @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  sentAt          DateTime?
  /// V1c (m1) : essais d'envoi push (échec définitif après 3).
  attempts        Int          @default(0)

  @@index([createdAt])
  @@index([sandboxId])
  /// V1c (m12) : requête du flush push (channel = PUSH, status = EN_ATTENTE, ordre createdAt).
  @@index([channel, status, createdAt])
}

model Feedback {
  id         String         @id @default(cuid())
  userId     String?
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  role       Role?
  /// Note 1 à 5.
  rating     Int
  message    String
  pagePath   String
  userAgent  String?
  /// Mesure (D15) : bac à sable et code testeur. Le code reste après la purge du bac à sable.
  sandboxId  String?
  sandbox    Sandbox?       @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  testerCode String?
  status     FeedbackStatus @default(NOUVEAU)
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([testerCode])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  /// Action en notation pointée, ex. "caregiver.validate", "visit.proof.elder_confirmed".
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─────────────────────────────── Test utilisateurs (S1b : D2, D3, D14, D15) ───────────────────────────────

/// Bac à sable d'un testeur : un monde fictif isolé (aîné, famille, accompagnants, opérateur « robots »).
/// Créé à la volée après un code d'invitation valide. Purgé après 30 jours.
model Sandbox {
  id                    String    @id @default(cuid())
  /// Code d'invitation testeur utilisé (TESTER_INVITE_CODES). Relie retours et mesures au testeur.
  testerCode            String
  /// Rôle joué par le testeur : FAMILLE ou ACCOMPAGNANT.
  role                  Role
  /// Empreinte SHA-256 du jeton du lien de reprise. Le jeton lui-même n'est jamais stocké.
  resumeTokenHash       String    @unique
  /// Acceptation des CGU de test (D4).
  cguAcceptedAt         DateTime
  /// Nombre de clics sur « Simuler la suite » (D14).
  simulationCount       Int       @default(0)
  /// Verrou de « Simuler la suite » (une seule simulation à la fois par bac à sable).
  simulationLockedUntil DateTime?
  lastSeenAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())

  users        User[]
  aines        Aine[]
  outbox       OutboxMessage[]
  feedbacks    Feedback[]
  usageEvents  UsageEvent[]
  microAnswers MicroAnswer[]
  discoveries  DiscoveryRequest[]

  @@index([createdAt])
  @@index([testerCode])
}

/// Événement d'usage (D15) : page vue ou action clé. Aucune donnée personnelle ni texte libre.
model UsageEvent {
  id         String   @id @default(cuid())
  sandboxId  String?
  sandbox    Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  testerCode String?
  /// Id du compte (sans clé étrangère : l'événement reste après la purge, anonyme).
  userId     String?
  role       Role?
  /// Notation pointée : "page.view", "sandbox.created", "simulate.step", "profile.chosen"…
  name       String
  path       String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([sandboxId])
  @@index([testerCode])
}

/// Réponse à une micro-question contextuelle (D15). Une réponse par compte et par question.
model MicroAnswer {
  id          String   @id @default(cuid())
  sandboxId   String?
  sandbox     Sandbox? @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  testerCode  String?
  userId      String
  role        Role?
  questionKey String
  answer      String
  createdAt   DateTime @default(now())

  @@unique([userId, questionKey])
  @@index([questionKey])
}

/// Offre factice « Réserver une vraie visite découverte » (D15). Contact RÉEL du testeur,
/// recueilli seulement avec son consentement explicite. Aucune donnée sur l'aîné.
model DiscoveryRequest {
  id                String         @id @default(cuid())
  sandboxId         String?
  sandbox           Sandbox?       @relation(fields: [sandboxId], references: [id], onDelete: SetNull)
  testerCode        String?
  userId            String?
  name              String
  /// Email ou téléphone donné par le testeur.
  contact           String
  /// Texte exact de la case cochée (preuve du consentement).
  consentText       String
  consentAt         DateTime
  /// Empreinte SHA-256 du jeton du lien « Retirer mon accord ». Le jeton n'est jamais stocké.
  withdrawTokenHash String?        @unique
  status            FeedbackStatus @default(NOUVEAU)
  createdAt         DateTime       @default(now())

  @@index([createdAt])
}

/// Limite de débit (M4, M5) en base : compatible serverless (pas de mémoire partagée).
/// Clé = action + empreinte (IP ou compte), jamais une IP ou un email en clair.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}

/// Jeton de renouvellement de l'API v1 (app mobile, ADR 0008, lot A1).
/// - Stocké en EMPREINTE (SHA-256), jamais en clair.
/// - Rotation : chaque usage crée un nouveau jeton de la même famille et marque l'ancien `usedAt`.
/// - Réutilisation d'un jeton déjà utilisé → toute la famille est révoquée.
/// - Lié à User.sessionVersion : un jeton d'une autre version est refusé.
/// - Effacé avec le compte (purge des bacs à sable comprise).
model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Famille = une connexion d'un appareil. Toutes les rotations gardent le même familyId.
  familyId       String
  /// Empreinte SHA-256 (hex) du jeton.
  tokenHash      String    @unique
  /// Identifiant du code de connexion échangé (premier jeton de la famille). Unique : un code sert une fois.
  authCodeId     String?   @unique
  /// Jeton précédent dans la famille (null pour le premier).
  parentId       String?
  /// User.sessionVersion au moment de l'émission.
  sessionVersion Int
  expiresAt      DateTime
  /// Date de rotation (le jeton a servi une fois).
  usedAt         DateTime?
  revokedAt      DateTime?
  /// DECONNEXION, REUTILISATION, VERSION_SESSION, CODE_REUTILISE…
  revokedReason  String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ─────────────────────────────── API v1 : événements de l'app (lot A2, ADR 0008) ───────────────────────────────

/// Événement envoyé par l'app accompagnant (file hors ligne). Sert à l'IDEMPOTENCE : un même clientEventId
/// n'est traité qu'une fois par compte. Ne contient AUCUNE donnée personnelle (ni code, ni position, ni texte).
model AppEvent {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// UUID créé par l'appareil.
  clientEventId String
  /// CHECK_IN, CHECK_OUT, KAYE_BROUILLON, KAYE_PUBLICATION, SOS.
  type          String
  visitId       String?
  /// Heure de l'appareil.
  occurredAt    DateTime
  /// Heure de réception par le serveur.
  receivedAt    DateTime @default(now())
  /// Écart d'horloge > 12 h entre occurredAt et receivedAt.
  clockSkew     Boolean  @default(false)
  /// Résultat renvoyé à l'app (rejoué tel quel pour un doublon). Null pendant le traitement.
  outcome       Json?

  @@unique([userId, clientEventId])
  @@index([visitId])
  @@index([receivedAt])
}

/// Brouillon de Kayé synchronisé depuis l'app. Effacé à la publication du Kayé (RGPD : minimum).
model KayeDraft {
  id         String   @id @default(cuid())
  visitId    String   @unique
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// Champs du Kayé en cours (humeur, appétit, activités, notes).
  content    Json
  /// Heure de l'appareil du dernier brouillon retenu (le plus récent gagne).
  occurredAt DateTime
  updatedAt  DateTime @updatedAt
}

/// Lot N1 : appareil qui reçoit les notifications push (jeton Expo Push).
/// Lié à UNE connexion de l'app (famille de jetons) : la déconnexion de l'appareil coupe le push.
/// RGPD : aucun texte de notification ici ; effacé avec le compte (cascade).
model PushDevice {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Jeton Expo (`ExponentPushToken[…]`). Unique : un appareil sert un seul compte à la fois.
  token         String       @unique
  platform      PushPlatform
  /// RefreshToken.familyId de la connexion qui a enregistré l'appareil.
  familyId      String
  createdAt     DateTime     @default(now())
  /// Dernier enregistrement (l'app renvoie son jeton à chaque ouverture).
  lastSeenAt    DateTime
  revokedAt     DateTime?
  /// DECONNEXION, NON_ENREGISTRE (réponse Expo DeviceNotRegistered), RETIRE (l'app le demande).
  revokedReason String?

  @@index([userId])
  @@index([familyId])
}

// ─────────────────────────────── L1-A : comptes réels, offre, accord de l'aîné ───────────────────────────────

/// L3 : usage d'un jeton envoyé par e-mail.
enum AccountTokenPurpose {
  /// Lien « Confirmer mon adresse e-mail » : 24 h, usage unique.
  VERIFICATION_EMAIL
  /// Lien « Choisir un nouveau mot de passe » : 1 h, usage unique.
  MOT_DE_PASSE
}

/// L3 : jeton à usage unique envoyé par e-mail.
/// - Stocké en EMPREINTE (SHA-256), jamais en clair.
/// - Un nouveau jeton du même usage annule les anciens.
/// - Effacé avec le compte ; purge nocturne des jetons expirés ou utilisés.
model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AccountTokenPurpose
  /// Empreinte SHA-256 (hex) du jeton.
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// L4 / R8 : état d'une demande de rappel pour une formule payante. Aucun encaissement.
enum ActivationStatus {
  /// La famille attend l'appel d'un conseiller.
  NOUVELLE
  /// Le conseiller a appelé la famille.
  RAPPELEE
  /// Demande close (sans suite, ou famille plus intéressée).
  CLOSE
}

/// L4 (J32) : demande de RAPPEL, pas une commande. Le conseiller n'encaisse rien tant que les CGV ne sont pas publiées.
/// J35 : effacée 3 mois après la dernière action si elle reste sans suite.
model PlanActivationRequest {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("ActivationRequester", fields: [userId], references: [id], onDelete: Cascade)
  /// Aîné concerné (null en préinscription : pas de fiche aîné).
  aineId      String?
  aine        Aine?            @relation(fields: [aineId], references: [id], onDelete: SetNull)
  plan        Plan
  status      ActivationStatus @default(NOUVELLE)
  handledById String?
  handledBy   User?            @relation("ActivationHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

/// R5 (J5) : accord de l'aîné, recueilli par un conseiller au téléphone (notice FALC).
enum AccordAine {
  EN_ATTENTE_ACCORD
  ACCORD_RECUEILLI
  ACCORD_REFUSE
  ACCORD_RETIRE
}

/// R5 (J5) : mesure de protection juridique de l'aîné.
enum SituationJuridique {
  AUCUNE
  TUTELLE
  CURATELLE
  HABILITATION_FAMILIALE
  MANDAT_PROTECTION_FUTURE
}

/// L1-B (L6) : trajet en direct de l'accompagnant vers le domicile. UNE ligne par visite, AUCUN historique :
/// seule la dernière position est gardée, ARRONDIE à ~110 m (R4). La ligne est EFFACÉE à la fin du trajet
/// (check-in, arrêt, arrivée à moins de 150 m du domicile, 60 min) et par la purge nocturne.
/// Jamais de position hors d'un trajet démarré par l'accompagnant lui-même. Jamais de coordonnées dans un journal.
model VisitTrip {
  id             String    @id @default(cuid())
  visitId        String    @unique
  visit          Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Compte de l'accompagnant qui partage sa position (effacé avec le compte).
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  /// Fin automatique : démarrage + 60 min (R4).
  expiresAt      DateTime
  /// R4 : point de départ (arrondi à ~110 m), gardé seulement pour masquer le départ (< 500 m). Effacé avec la ligne.
  startLatitude  Float?
  startLongitude Float?
  /// Dernière position (null tant qu'aucune position n'est reçue).
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  /// Heure de la position sur l'appareil (jamais dans le futur du serveur).
  positionAt     DateTime?
  /// Heure de réception de la dernière position (limite : 1 envoi / 10 s).
  receivedAt     DateTime?

  @@index([expiresAt])
  @@index([userId])
}
