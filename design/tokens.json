{
  "$description": "Jetons de design Koudmen (source unique, ADR 0008 § 3.4). Valeurs : docs/design/direction-artistique.md § 3 à § 9 et site/maquette-conso.html. Ne modifiez pas globals.css à la main : lancez `node design/scripts/build-tokens.mjs`.",
  "version": 1,
  "color": {
    "light": {
      "bg": { "value": "#F6F2EA", "role": "sable : fond d'app" },
      "surface": { "value": "#FFFDF8", "role": "coton : cartes" },
      "surface-2": { "value": "#EFE9DE", "role": "sable creusé : puces, champs, piste" },
      "fg": { "value": "#1A2321", "role": "encre : texte" },
      "muted": { "value": "#5A645F", "role": "texte secondaire" },
      "line": { "value": "#E3DBCD", "role": "filet décoratif (non porteur d'information)" },
      "line-strong": { "value": "#8A877D", "role": "bord des contrôles (>= 3:1)" },
      "mer": { "value": "#0D5F58", "role": "agir : bouton principal, lien, onglet actif" },
      "mer-strong": { "value": "#0A4C46", "role": "survol et pression du bouton principal" },
      "mer-soft": { "value": "#E2EEEA", "role": "fond d'onglet actif" },
      "on-mer": { "value": "#FFFFFF", "role": "texte sur mer" },
      "soleil": { "value": "#E0A21B", "role": "décor uniquement, jamais du texte" },
      "soleil-ink": { "value": "#7E5300", "role": "texte « soleil » : créole, conseil" },
      "soleil-soft": { "value": "#F8EDD3", "role": "fond de badge soleil" },
      "on-soleil": { "value": "#1A2321", "role": "texte sur soleil" },
      "hibiscus": { "value": "#A8283F", "role": "alerte seulement (et le jour dans la date)" },
      "hibiscus-soft": { "value": "#F6E1E3", "role": "fond d'alerte" },
      "on-hibiscus": { "value": "#FFFFFF", "role": "texte sur hibiscus" },
      "feuille": { "value": "#2B6A30", "role": "va bien, preuve validée" },
      "feuille-soft": { "value": "#E4EFE1", "role": "fond de badge « Prouvée »" },
      "focus": { "value": "#1A2321", "role": "anneau de focus" },
      "focus-halo": { "value": "#E0A21B", "role": "halo de focus" }
    },
    "dark": {
      "bg": { "value": "#0F1413" },
      "surface": { "value": "#171D1C" },
      "surface-2": { "value": "#212927" },
      "fg": { "value": "#EEE9E0" },
      "muted": { "value": "#A3ABA6" },
      "line": { "value": "#262F2D" },
      "line-strong": { "value": "#6E7975" },
      "mer": { "value": "#6CC9BB" },
      "mer-strong": { "value": "#8AD6CA" },
      "mer-soft": { "value": "#18302C" },
      "on-mer": { "value": "#0B1110" },
      "soleil": { "value": "#F0BD4F" },
      "soleil-ink": { "value": "#F0BD4F" },
      "soleil-soft": { "value": "#2E2614" },
      "on-soleil": { "value": "#0B1110" },
      "hibiscus": { "value": "#F2879A" },
      "hibiscus-soft": { "value": "#33191F" },
      "on-hibiscus": { "value": "#0B1110" },
      "feuille": { "value": "#8BCB8E" },
      "feuille-soft": { "value": "#1A2A1C" },
      "focus": { "value": "#F0BD4F" },
      "focus-halo": { "value": "#0F1413" }
    }
  },
  "illustration": {
    "$description": "Aplats des illustrations au trait (§ 8). Ils suivent le thème.",
    "light": {
      "sky-1": "#F3DDB9",
      "sky-2": "#F8EEDF",
      "sea-1": "#9CC7BE",
      "sea-2": "#5E9F95",
      "hill": "#B9C9A6",
      "pump": "#D99A3A",
      "leaf": "#6F9265",
      "stroke": "#1A2321"
    },
    "dark": {
      "sky-1": "#2A2F33",
      "sky-2": "#1A2124",
      "sea-1": "#24504B",
      "sea-2": "#1A3B37",
      "hill": "#2C3A2E",
      "pump": "#B9802F",
      "leaf": "#4E6B48",
      "stroke": "#EEE9E0"
    }
  },
  "effect": {
    "light": {
      "shadow": "0 1px 2px rgb(40 32 20 / .05), 0 10px 30px -14px rgb(40 32 20 / .18)",
      "shadow-lg": "0 2px 4px rgb(40 32 20 / .04), 0 30px 60px -30px rgb(40 32 20 / .35)",
      "photo-filter": "none"
    },
    "dark": {
      "shadow": "0 0 0 1px rgb(255 255 255 / .04)",
      "shadow-lg": "0 30px 60px -30px rgb(0 0 0 / .8)",
      "photo-filter": "brightness(.92) saturate(.9)"
    }
  },
  "font": {
    "sans": { "family": "Figtree", "fallback": ["ui-sans-serif", "system-ui", "sans-serif"], "weights": [400, 500, 600, 700] },
    "display": { "family": "Fraunces", "fallback": ["ui-serif", "Georgia", "serif"], "weights": [400, 500], "italic": true, "axes": ["opsz"] },
    "mono": { "family": "ui-monospace", "fallback": ["Menlo", "monospace"] }
  },
  "typeScale": {
    "$description": "Mobile. size en px, lineHeight sans unité, tracking en em.",
    "display": { "family": "display", "size": 42, "lineHeight": 1.02, "tracking": -0.025, "weight": 400 },
    "h1": { "family": "display", "size": 36, "lineHeight": 1.05, "tracking": -0.02, "weight": 400 },
    "h2": { "family": "display", "size": 28, "lineHeight": 1.12, "tracking": -0.02, "weight": 400 },
    "greeting": { "family": "display", "size": 30, "lineHeight": 1.1, "tracking": -0.02, "weight": 400 },
    "quote": { "family": "display", "size": 21, "lineHeight": 1.3, "tracking": -0.005, "weight": 400, "italic": true },
    "title": { "family": "sans", "size": 17, "lineHeight": 1.3, "weight": 600 },
    "body": { "family": "sans", "size": 17, "lineHeight": 1.55, "weight": 400 },
    "small": { "family": "sans", "size": 15, "lineHeight": 1.4, "weight": 400 },
    "caption": { "family": "sans", "size": 13.5, "lineHeight": 1.3, "weight": 500 },
    "eyebrow": { "family": "sans", "size": 13, "lineHeight": 1.3, "tracking": 0.12, "weight": 600, "uppercase": true },
    "figure": { "family": "sans", "size": 24, "lineHeight": 1.1, "tracking": -0.01, "weight": 600, "tabular": true }
  },
  "radius": {
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 24,
    "2xl": 28,
    "icon": 14,
    "field": 16,
    "button": 18,
    "media": 20,
    "card": 24,
    "hero": 28,
    "pill": 999
  },
  "space": [4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 56],
  "layout": {
    "gutter": 20,
    "gutterNarrow": 16,
    "appColumn": 440,
    "contentMax": 1120,
    "bottomReserve": 120,
    "target": 44,
    "buttonHeight": 56,
    "buttonHeightLarge": 60,
    "buttonQuietHeight": 52
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "320ms",
    "easeOut": "cubic-bezier(.2, .8, .2, 1)",
    "easeIn": "ease-in",
    "breathe": "3.2s"
  }
}
