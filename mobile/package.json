{
  "name": "koudmen-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export -p web",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "export:web:reel": "EXPO_PUBLIC_API_URL=/ expo export -p web --clear",
    "export:web:simule": "EXPO_PUBLIC_API_MODE=simule expo export -p web --output-dir dist-simule --clear",
    "proxy:dev": "node scripts/proxy-dev.mjs",
    "e2e:simule": "playwright test -c e2e/playwright.simule.config.ts",
    "test:push": "playwright test -c src/push/__tests__/unitaires.config.ts",
    "test:natif": "playwright test -c src/native/__tests__/unitaires.config.ts",
    "e2e:natif": "playwright test -c src/native/__tests__/playwright.config.ts",
    "test:hors-ligne": "playwright test -c src/offline/__tests__/unitaires.config.ts",
    "e2e:hors-ligne": "playwright test -c src/offline/__tests__/playwright.config.ts",
    "export:web:hors-ligne": "EXPO_PUBLIC_API_URL=/ expo export -p web --output-dir dist-hors-ligne --clear"
  },
  "private": true
}
